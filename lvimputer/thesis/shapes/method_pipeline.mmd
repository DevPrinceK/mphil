%% Figure 3.1: End-to-end methodology pipeline
%% Redrawn as a thesis-ready workflow: shared data/masks first, then baseline and
%% hybrid branches, then a common evaluation layer.
%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Segoe UI, Arial, sans-serif", "background": "transparent", "primaryTextColor": "#17202a", "lineColor": "#617285"}}}%%
flowchart LR
    subgraph Prep["Data preparation"]
        A["Timestamped temperature data<br/>data/dataset1.csv"] --> B["Chronological sorting<br/>temperature channel only"]
        B --> C["Training-only robust cleaning<br/>sentinel and local artefact handling"]
    end

    subgraph Mask["Shared masking protocol"]
        C --> D["Controlled 30% masks<br/>START / MIDDLE / END / RANDOM"]
    end

    subgraph Methods["Imputation methods"]
        D --> E1["Statistical and time-aware<br/>baselines"]
        D --> E2["Lag-feature machine-learning<br/>baselines"]
        D --> P["Scenario-specific prior<br/>interpolation or seasonal KNN"]
        P --> E3["Prior-guided residual<br/>LSTM-VAE"]
    end

    E1 --> F["Completed series"]
    E2 --> F
    E3 --> F

    subgraph Eval["Evaluation and interpretation"]
        F --> G["Masked-point error<br/>MAE and RMSE"]
        F --> H["Qualitative reconstruction<br/>plots"]
        F --> I["Imputation-only runtime<br/>training excluded"]
        G --> J["Win rate and method<br/>comparison"]
        H --> J
        I --> J
    end

    classDef data fill:#edf4fb,stroke:#42647f,stroke-width:1.5px,color:#17202a;
    classDef process fill:#ecf6f0,stroke:#3f7a5a,stroke-width:1.5px,color:#17202a;
    classDef model fill:#fff4df,stroke:#b37219,stroke-width:1.5px,color:#17202a;
    classDef hybrid fill:#f7ecf7,stroke:#7f4b86,stroke-width:1.5px,color:#17202a;
    classDef eval fill:#fef0ec,stroke:#b64c39,stroke-width:1.5px,color:#17202a;
    class A,B data;
    class C,D,F process;
    class E1,E2,P model;
    class E3 hybrid;
    class G,H,I,J eval;
