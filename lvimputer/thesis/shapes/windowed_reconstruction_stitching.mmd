%% Figure 3.7: Windowed inference and overlap averaging
%% Inference is windowed, stitched by overlap averaging, then filtered through a
%% conservative residual gate before final replacement.
%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Segoe UI, Arial, sans-serif", "background": "transparent", "primaryTextColor": "#17202a", "lineColor": "#617285"}}}%%
flowchart LR
    A["Full masked sequence"] --> B["Scenario-specific prior"]
    B --> C["Overlapping windows<br/>length 96, evaluation stride 48"]

    C --> D1["Window 1<br/>residual prediction"]
    C --> D2["Window 2<br/>residual prediction"]
    C --> D3["Window k<br/>residual prediction"]

    D1 --> E["Collect predictions<br/>by timestamp"]
    D2 --> E
    D3 --> E
    E --> F["Overlap average<br/>one value per timestamp"]

    F --> G["Validation residual gate"]
    G --> H{"Improves both<br/>MAE and RMSE?"}
    H -->|"Yes"| I["Blend prior with<br/>residual prediction"]
    H -->|"No"| J["Keep prior unchanged"]
    I --> K["Final imputed series"]
    J --> K
    K --> L["Observed raw values retained<br/>only hidden points replaced"]

    classDef input fill:#edf4fb,stroke:#42647f,stroke-width:1.5px,color:#17202a;
    classDef window fill:#ecf6f0,stroke:#3f7a5a,stroke-width:1.5px,color:#17202a;
    classDef gate fill:#fff4df,stroke:#b37219,stroke-width:1.5px,color:#17202a;
    classDef output fill:#f7ecf7,stroke:#7f4b86,stroke-width:1.5px,color:#17202a;
    class A,B input;
    class C,D1,D2,D3,E,F window;
    class G,H,I,J gate;
    class K,L output;
