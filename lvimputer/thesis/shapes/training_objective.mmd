    classDef model fill:#eef7f1,stroke:#4f8a66,color:#17202a;
    classDef loss fill:#fff4e6,stroke:#c47f2c,color:#17202a;
    classDef opt fill:#f7eef7,stroke:#8b5a8c,color:#17202a;
    class A data;
    class B,C model;
    class D,E,F,G,H loss;
    class I,J,K,L opt;
