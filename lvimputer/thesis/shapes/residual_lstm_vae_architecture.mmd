%% Figure 3.5: Prior-guided residual LSTM-VAE architecture
%% This redraw removes generic detector/normaliser blocks and shows the actual
%% algorithmic components: prior construction, residual decoding, and gating.
%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Segoe UI, Arial, sans-serif", "background": "transparent", "primaryTextColor": "#17202a", "lineColor": "#617285"}}}%%
flowchart LR
    subgraph Input["Input representation"]
        A["Masked window u_1:T<br/>filled value, mask, prior, calendar"]
        P["Prior sequence p_t<br/>interpolation or seasonal KNN"]
    end

    subgraph Enc["Encoder"]
        A --> B["Encoder LSTM"]
        B --> C["Final hidden state"]
        C --> D["Latent mean mu"]
        C --> E["Latent log variance"]
    end

    subgraph Latent["VAE latent space"]
        D --> F["Reparameterisation<br/>mean used at evaluation"]
        E --> F
        F --> G["Latent code z"]
        G --> H["Repeat z across window"]
    end

    subgraph Dec["Decoder and residual head"]
        P --> I["Decoder context<br/>prior + calendar features"]
        H --> J["Concatenate"]
        I --> J
        J --> K["Decoder LSTM"]
        K --> L["Residual head"]
        L --> M["Residual correction r_t"]
    end

    P --> O["Hybrid prediction<br/>x_hat_t = p_t + r_t"]
    M --> O
    O --> Q{"Validation gate<br/>improves MAE and RMSE?"}
    Q -->|"Yes"| R["Use residual blend"]
    Q -->|"No"| S["Keep prior unchanged"]
    P --> S
    R --> T["Final imputed series<br/>replace only hidden points"]
    S --> T

    classDef input fill:#edf4fb,stroke:#42647f,stroke-width:1.5px,color:#17202a;
    classDef encoder fill:#ecf6f0,stroke:#3f7a5a,stroke-width:1.5px,color:#17202a;
    classDef latent fill:#fff4df,stroke:#b37219,stroke-width:1.5px,color:#17202a;
    classDef decoder fill:#f7ecf7,stroke:#7f4b86,stroke-width:1.5px,color:#17202a;
    classDef output fill:#fef0ec,stroke:#b64c39,stroke-width:1.5px,color:#17202a;
    class A,P input;
    class B,C encoder;
    class D,E,F,G,H latent;
    class I,J,K,L,M decoder;
    class O,Q,R,S,T output;
